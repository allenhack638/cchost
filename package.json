    "claude-code",
    "anthropic",
    "cli",
    "profile",
    "multi-account",
    "credentials",
    "isolation",
    "macos",
    "windows",
    "linux"
  ],
  "homepage": "https://github.com/allenhack638/cchost#readme",
  "bugs": {
    "url": "https://github.com/allenhack638/cchost/issues"
  },
  "license": "MIT",
  "author": "Allen Benny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenhack638/cchost.git"
  },
  "bin": {
    "cchost": "bin/cc.js",
    "cc": "bin/cc.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "lib",
    "agent",
    "skills",
    ".claude-plugin",
    "README.md",
